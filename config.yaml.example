# sub-title 配置模板
# 复制为 config.yaml 放在你的用户数据目录（见 README「数据存储位置」）：
#   Windows: %APPDATA%\sub-title\config.yaml
#   macOS:   ~/Library/Application Support/sub-title/config.yaml
#   Linux:   ~/.config/sub-title/config.yaml
#
# 重要：本文件**不包含任何 API key**。AccessKey / Secret / AppKey 由设置对话框
# 写入系统保险箱（Windows Credential Manager / macOS Keychain / Linux libsecret），
# 绝不放进 config.yaml。

audio:
  target_sample_rate: 16000
  chunk_seconds: 0.6
  input_device: null            # null = 系统默认输出设备

asr:
  engine_type: funasr           # funasr / sensevoice / funasr_nano / qwen3_asr / faster_whisper / aliyun
  # ---- FunASR Paraformer（本地流式，GPU 推荐）----
  model: paraformer-zh-streaming
  device: cuda                  # cuda / cpu
  chunk_size: [0, 10, 5]
  encoder_chunk_look_back: 4
  decoder_chunk_look_back: 1
  disable_update: true
  punc_model: ct-punc
  # ---- SenseVoice（本地段式，CPU 可跑）----
  sensevoice_model: iic/SenseVoiceSmall
  sensevoice_device: cpu        # Mac 用 cpu
  sensevoice_segment_seconds: 2.0
  # ---- Fun-ASR-Nano（中文/方言/歌词，GPU 推荐）----
  funasr_nano_model: FunAudioLLM/Fun-ASR-Nano-2512
  funasr_nano_device: cuda
  funasr_nano_language: 中文
  funasr_nano_segment_seconds: 2.0
  # ---- Qwen3-ASR（多语种/歌曲，需额外 pip install qwen-asr；从 ModelScope 下载）----
  qwen3_asr_model: Qwen/Qwen3-ASR-0.6B
  qwen3_asr_device: cuda
  qwen3_asr_quantization: none # none / 4bit（CUDA + bitsandbytes，非 GGUF）
  qwen3_asr_language: Chinese
  qwen3_asr_segment_seconds: 2.0
  # ---- faster-whisper（兼容模式：静音/音乐暂停时可能产生幻觉字幕）----
  # 模型从 ModelScope 下载；旧的 large-v3-turbo 配置会自动改用 large-v3。
  faster_whisper_model: large-v3
  faster_whisper_vad_filter: true
  # ---- 阿里云 NLS（云端，任意平台）----
  aliyun_region: cn-shanghai    # region 不是密钥，可以放这里
  # aliyun_access_key_id / aliyun_access_key_secret / aliyun_appkey
  # 这三个字段**不要**填在这里！去「设置 → 识别 → 阿里云 API」里填，会自动存到系统保险箱。

ui:
  font_family: Microsoft YaHei
  font_size: 22
  window_opacity: 0.88
  max_chars: 20000
  theme: Dark                   # Dark / Light / Nord / Tokyo Night / ...
  always_on_top: true
  close_action: ask             # ask / hide / quit
  toolbar_hide_delay_ms: 800
  lock_scroll_to_bottom: false
  min_win_w: 30                 # 注意：实际被代码硬覆盖为 30，这里只是字段保留
  min_win_h: 30

skin:
  enabled: false
  active_skin: ''
  skins_dir: skins               # 相对用户数据目录，也可以填写绝对路径
  editor_grid_snap: true
  editor_grid_size: 8
  editor_show_guides: true
  animation_fps: 30
  animation_loop: true

# ============================================================
# 翻译功能（可选）
# ============================================================
# 开启后：ASR 定稿句异步翻译，译文显示在字幕窗口底部独立一行，与原文各行出字、
# 互不干扰（翻译后台线程，不阻塞 ASR）。关闭（enabled: false）= 单行原文，零回归。
translate:
  enabled: false                # 总开关
  engine: azure                 # azure（推荐，官方免费层）/ google（免 key，易限流）/
                                # libretranslate / nllb（本地离线）
  source_lang: auto             # auto=自动检测（Azure/Google 支持；本地引擎需具体码）
  target_lang: zh-Hans          # 目标语言
  translate_final_only: true    # 只翻定稿句（避免 partial 频繁重译，建议保持 true）

  # ---- 本地服务地址（仅 engine=libretranslate / nllb 用）----
  # 复用 WSL 起服务模式（同 nano 流式）。服务需自行启动：
  #   LibreTranslate: docker run -p 5000:5000 libretranslate/libretranslate --load-only en,zh
  #   NLLB-200:       pip install git+https://github.com/thammegowda/nllb-serve 后 nllb-serve
  libretranslate_host: localhost
  libretranslate_port: 5000
  nllb_host: localhost
  nllb_port: 6060

  # ---- 译文样式 ----
  translation_font_scale: 0.85  # 译文字号 = 原文字号 × 此值
  translation_color: ''         # 空=跟随主题文本色；填 hex（如 #5aa9ff）自定义

  # Azure Translator 凭证（key + region）**不在这里**！
  # 去「设置 → 翻译」填，会自动存到系统保险箱（与阿里云凭证同等安全）。
  # 免费层 F0：每小时 200 万字符，无需付费。申请：Azure 门户 → 创建「翻译器」资源。
